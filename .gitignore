# =============================================================
# .gitignore — Central de Serviços MTP
# Stack: React 19 + TypeScript + Vite + Supabase
# =============================================================

# ── Variáveis de ambiente (NUNCA versionar) ──────────────────
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local

# ── Dependências ─────────────────────────────────────────────
node_modules/

# ── Build / dist ─────────────────────────────────────────────
dist/
dist-ssr/
build/

# ── Cache do TypeScript ───────────────────────────────────────
*.tsbuildinfo
tsconfig.tsbuildinfo

# ── Cache do Vite ────────────────────────────────────────────
.vite/

# ── Logs ─────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Cobertura de testes ───────────────────────────────────────
coverage/
*.lcov

# ── Configuração local do agente (dados pessoais) ─────────────
.docs/meu_git.txt
.docs/Prompt_Github.txt

# ── Sistema Operacional ───────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Editores e IDEs ───────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Arquivos temporários ──────────────────────────────────────
*.tmp
*.temp
*.bak
*.orig

